# Copy to .env (never commit .env). No secrets are hardcoded in code.
# Database — PostgreSQL via Supabase (pooled + direct)
DATABASE_URL="postgresql://user:password@db.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.supabase.co:5432/postgres"

# Auth.js / NextAuth — email (Resend) + Google OAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Magic-link sender (Resend)
AUTH_EMAIL_FROM="Plannly <noreply@yourdomain.com>"

# File storage — S3-compatible (Cloudflare R2 or Supabase Storage S3 endpoint)
STORAGE_PROVIDER="r2"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="plannly"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Payments — Paystack (provider-swappable via PAYMENTS_PROVIDER)
PAYMENTS_PROVIDER="paystack"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Email — Resend transactional
RESEND_API_KEY=""
EMAIL_FROM="Plannly <noreply@yourdomain.com>"

# App
APP_URL="http://localhost:3000"
