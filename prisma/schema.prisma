generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

// --- Auth.js / NextAuth models (prisma-adapter) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  notifications Notification[]
  payments      Payment[]
  emailProfile  EmailProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Plannly domain ---
model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  rawInput    String
  targetDate  DateTime?
  timeBudget  String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
}

model Milestone {
  id        String   @id @default(cuid())
  goalId    String
  title     String
  dueDate   DateTime?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  goal            Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  monthlyOutcomes MonthlyOutcome[]
}

model MonthlyOutcome {
  id          String @id @default(cuid())
  milestoneId String
  title       String
  month       String
  position    Int    @default(0)

  milestone        Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  weeklyObjectives WeeklyObjective[]
}

model WeeklyObjective {
  id               String @id @default(cuid())
  monthlyOutcomeId String
  title            String
  week             String
  position         Int    @default(0)

  monthlyOutcome MonthlyOutcome @relation(fields: [monthlyOutcomeId], references: [id], onDelete: Cascade)
  dailyActions   DailyAction[]
}

model DailyAction {
  id                String   @id @default(cuid())
  weeklyObjectiveId String
  title             String
  tinyStep          String?
  estimateMinutes   Int?
  dueDate           DateTime?
  done              Boolean  @default(false)
  position          Int      @default(0)

  weeklyObjective WeeklyObjective @relation(fields: [weeklyObjectiveId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  goalId      String?
  title       String
  detail      String?
  done        Boolean  @default(false)
  parentId    String?
  depth       Int      @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parent Task?  @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[] @relation("TaskChildren")
}

model ProgressEvent {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  actionId  String?
  kind      String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  title     String
  context   String?
  dueAt     DateTime
  status    String    @default("pending")
  snoozedUntil DateTime?
  createdAt DateTime  @default(now())
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  provider    String   @default("local")
  externalId  String?
  createdAt   DateTime @default(now())
}

model EmailProfile {
  id         String @id @default(cuid())
  userId     String @unique
  tone       String?
  formality  String?
  greeting   String?
  signoff    String?
  samples    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Template {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  name      String
  body      String
  createdAt DateTime @default(now())
}

model Workflow {
  id        String   @id @default(cuid())
  userId    String
  name      String
  schedule  String?
  steps     Json
  createdAt DateTime @default(now())
  runs      WorkflowRun[]
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  status     String   @default("started")
  result     Json?
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

// Phase 1: in-app + email only. SMS/WhatsApp are future channels.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Provider-agnostic payments (Paystack first, others pluggable).
model Payment {
  id        String   @id @default(cuid())
  userId    String
  provider  String   @default("paystack")
  reference String   @unique
  amount    Int
  currency  String   @default("NGN")
  status    String   @default("pending")
  raw       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
